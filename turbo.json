{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["eslint.config.js", ".prettierrc.mjs", "tsconfig.base.json"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"], "env": ["SANDBOX_BASE"] },
    "typecheck": { "dependsOn": ["^build"] },
    "lint": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"] },
    "test:browser": { "dependsOn": ["^build", "build"] },
    "generate": { "cache": false }
  }
}
