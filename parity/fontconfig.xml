<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<!--
  For the browser the parity suite launches, so a page compares the same on every Linux machine.

  PDF.js draws text through the browser, which takes sub-pixel colouring and hinting from the
  machine's font settings. Coloured glyph edges alone put a region of text over the comparison's
  limits, so both are fixed here.

  PDF.js draws an unembedded Helvetica or Arial with the first font of the list below that the
  machine has, and with its own bundled Liberation Sans when it has none. Hiding them all makes
  every machine draw the bundled font. The list is the one in PDF.js's font substitutions.
-->
<fontconfig>
  <include ignore_missing="yes">/etc/fonts/fonts.conf</include>
  <match target="font">
    <edit name="rgba" mode="assign"><const>none</const></edit>
    <edit name="antialias" mode="assign"><bool>true</bool></edit>
    <edit name="hinting" mode="assign"><bool>true</bool></edit>
    <edit name="hintstyle" mode="assign"><const>hintslight</const></edit>
  </match>
  <selectfont>
    <rejectfont>
      <pattern><patelt name="family"><string>Helvetica</string></patelt></pattern>
      <pattern><patelt name="family"><string>Helvetica Neue</string></patelt></pattern>
      <pattern><patelt name="family"><string>Arial</string></patelt></pattern>
      <pattern><patelt name="family"><string>Arimo</string></patelt></pattern>
      <pattern><patelt name="family"><string>Liberation Sans</string></patelt></pattern>
      <pattern><patelt name="family"><string>Nimbus Sans</string></patelt></pattern>
      <pattern><patelt name="family"><string>Nimbus Sans L</string></patelt></pattern>
      <pattern><patelt name="family"><string>A030</string></patelt></pattern>
      <pattern><patelt name="family"><string>TeX Gyre Heros</string></patelt></pattern>
      <pattern><patelt name="family"><string>FreeSans</string></patelt></pattern>
      <pattern><patelt name="family"><string>DejaVu Sans</string></patelt></pattern>
      <pattern><patelt name="family"><string>Albany</string></patelt></pattern>
      <pattern><patelt name="family"><string>Bitstream Vera Sans</string></patelt></pattern>
      <pattern><patelt name="family"><string>Arial Unicode MS</string></patelt></pattern>
      <pattern><patelt name="family"><string>Microsoft Sans Serif</string></patelt></pattern>
      <pattern><patelt name="family"><string>Apple Symbols</string></patelt></pattern>
      <pattern><patelt name="family"><string>Cantarell</string></patelt></pattern>
    </rejectfont>
  </selectfont>
</fontconfig>
