{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client", "@inkbar/core/vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "vite/**/*.ts",
    "e2e/**/*.ts"
  ],
  "exclude": ["src/svelte/**"],
  "vueCompilerOptions": { "strictTemplates": true, "dataAttributes": ["data-*"] }
}
