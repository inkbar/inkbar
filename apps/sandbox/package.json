{
  "name": "@inkbar/sandbox",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.json && svelte-check --tsconfig ./tsconfig.svelte.json",
    "lint": "eslint src vite e2e --no-error-on-unmatched-pattern",
    "test": "node --test \"vite/*.test.ts\" \"src/plugin/*.test.ts\"",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@fontsource-variable/urbanist": "^5.3.0",
    "@inkbar/core": "workspace:*",
    "@inkbar/react": "workspace:*",
    "@inkbar/svelte": "workspace:*",
    "@inkbar/theme": "workspace:*",
    "@inkbar/vue": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svelte": "^5.57.2",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@inkbar/e2e-shared": "workspace:*",
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "pdf-lib": "^1.17.1",
    "shiki": "^4.5.0",
    "svelte-check": "^4.7.6",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
