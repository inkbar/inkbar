{
  "name": "@inkbar/demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.json",
    "lint": "eslint src vite e2e --no-error-on-unmatched-pattern",
    "test": "node --test \"vite/*.test.ts\" \"src/shared/*.test.ts\"",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@fontsource-variable/urbanist": "^5.3.0",
    "@inkbar/core": "workspace:*",
    "@inkbar/react": "workspace:*",
    "@inkbar/theme": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@inkbar/sandbox-shared": "workspace:*",
    "@playwright/test": "1.62.1",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "pdf-lib": "^1.17.1",
    "shiki": "^4.5.0",
    "vite": "^8.3.4"
  }
}
