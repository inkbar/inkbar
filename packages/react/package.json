{
  "name": "@inkbar/react",
  "version": "0.6.0",
  "description": "React components and hooks for Inkbar, the browser PDF viewer and editor.",
  "license": "MIT",
  "homepage": "https://inkbar.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inkbar/inkbar.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/inkbar/inkbar/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src playwright",
    "test": "vitest run",
    "test:browser": "playwright test -c playwright-ct.config.ts"
  },
  "dependencies": {
    "@inkbar/icons": "workspace:^",
    "radix-ui": "^1.8.1"
  },
  "peerDependencies": {
    "@inkbar/core": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@inkbar/core": "workspace:*",
    "@inkbar/fixtures": "workspace:*",
    "@inkbar/theme": "workspace:*",
    "@playwright/experimental-ct-react": "1.62.1",
    "@playwright/test": "1.62.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
