{
  "name": "@inkbar/core",
  "version": "0.1.1",
  "description": "PDF document model, rendering and annotations for the browser. No framework.",
  "license": "MIT",
  "homepage": "https://inkbar.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inkbar/inkbar.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/inkbar/inkbar/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "schema.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./dom": {
      "types": "./dist/dom.d.mts",
      "default": "./dist/dom.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "default": "./dist/vite.mjs"
    },
    "./vite/client": {
      "types": "./dist/vite/client.d.ts"
    },
    "./schema.json": "./schema.json",
    "./package.json": "./package.json"
  },
  "imports": {
    "#pdfjs": {
      "node": "pdfjs-dist/legacy/build/pdf.mjs",
      "default": "pdfjs-dist"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run --project node",
    "generate": "tsx scripts/generate-schema.ts",
    "test:browser": "vitest run --project browser"
  },
  "dependencies": {
    "pdfjs-dist": "^6.4.299",
    "uuid": "^14.0.3",
    "zod": "^4.6.6"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@inkbar/fixtures": "workspace:*",
    "@vitest/browser-playwright": "^5.0.4",
    "ajv": "^8.20.0",
    "fast-check": "^4.10.2",
    "playwright": "1.62.1",
    "tsdown": "^0.23.1",
    "tsx": "^4.20.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
