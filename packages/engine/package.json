{
  "name": "@inkbar/engine",
  "version": "0.17.0",
  "description": "Opens, renders and writes PDFs for Inkbar: PDFium compiled to WebAssembly.",
  "license": "MIT",
  "homepage": "https://inkbar.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inkbar/inkbar.git",
    "directory": "packages/engine"
  },
  "bugs": "https://github.com/inkbar/inkbar/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.3"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./worker": {
      "default": "./dist/worker.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "fetch": "node scripts/fetch-pdfium.ts",
    "build": "node scripts/fetch-pdfium.ts && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src scripts",
    "test": "node scripts/fetch-pdfium.ts && vitest run --project node",
    "test:browser": "node scripts/fetch-pdfium.ts && vitest run --project browser"
  },
  "dependencies": {
    "gloss-format": "^1.2.0"
  },
  "devDependencies": {
    "@inkbar/fixtures": "workspace:*",
    "@inkbar/fonts": "^1.0.0",
    "@vitest/browser-playwright": "^5.0.4",
    "pdfjs-dist": "^6.4.299",
    "playwright": "1.62.1",
    "tsdown": "^0.23.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
