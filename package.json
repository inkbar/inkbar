{
  "name": "inkbar-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:browser": "turbo run test:browser",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "release": "release-it"
  },
  "lint-staged": {
    "*.{ts,mts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,css,json,yml,yaml,md,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
    "@ecssc/commitlint-config": "^0.0.5",
    "@ecssc/eslint-config": "^1.0.2",
    "@ecssc/prettier-config": "^0.1.3",
    "@ecssc/release-it-config": "^1.0.3",
    "@types/node": "^24",
    "eslint": "^10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "release-it": "^20.0.0",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3"
  }
}
